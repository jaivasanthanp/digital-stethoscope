/*
 * nRF52840 DK devicetree overlay
 *
 * UART1 carries bidirectional traffic with the STM32U575:
 *   - RX: 6-byte classification packets from STM32 PD5 (USART2 TX, NUCLEO D53)
 *   - TX: 'B' command + 16 KB int16 PCM audio windows to STM32 PD6
 *         (USART2 RX), part of the phone -> BLE -> nRF -> STM32 streaming path
 *
 * nRF52840DK pin connections to STM32 NUCLEO-U575ZI-Q:
 *   nRF P0.08 (UART1 RX) <- STM32 PD5 (USART2 TX, D53)
 *   nRF P1.02 (UART1 TX) -> STM32 PD6 (USART2 RX, D52)
 *   GND <-> GND (common ground between boards)
 *
 * Why P1.02 (not P0.06 or P0.07) for UART1 TX:
 *   The nRF52840 DK ties P0.05/P0.06/P0.07/P0.08 to the onboard J-Link OB
 *   interface UART (RXD/TXD/CTS/RTS) via factory-intact solder bridges
 *   SB5/SB6/SB7/SB8. P0.08 happens to work for RX (J-Link is high-Z there)
 *   but using P0.06 or P0.07 as nRF outputs has the J-Link MCU actively
 *   driving the same line, and the contention silently kills our bytes.
 *   P1.02 is the Zephyr board-file default for uart1_default_alt and is
 *   guaranteed J-Link-free.
 *
 * Zephyr 4.x requires both "default" and "sleep" pinctrl states for
 * nRF UART nodes (pinctrl-0 / pinctrl-1 + pinctrl-names with 2 entries).
 */

&pinctrl {
    uart1_default: uart1_default {
        group1 {
            psels = <NRF_PSEL(UART_RX, 0, 8)>,
                    <NRF_PSEL(UART_TX, 1, 2)>;
        };
    };

    uart1_sleep: uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_RX, 0, 8)>,
                    <NRF_PSEL(UART_TX, 1, 2)>;
            low-power-enable;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_default>;
    pinctrl-1 = <&uart1_sleep>;
    pinctrl-names = "default", "sleep";
};
