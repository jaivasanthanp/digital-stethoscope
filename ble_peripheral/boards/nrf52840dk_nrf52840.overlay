/*
 * nRF52840 DK devicetree overlay
 *
 * UART1 receives 6-byte packets from STM32U575 CommThread over the
 * hardware UART bridge (not USB CDC — that is UART0/USB).
 *
 * nRF52840DK pin connections to STM32 NUCLEO:
 *   nRF P0.08 (UART1 RX) <- STM32 USART3 TX (PD8)
 *   GND <-> GND (common ground between boards)
 *
 * Zephyr 4.x requires both "default" and "sleep" pinctrl states for
 * nRF UART nodes (pinctrl-0 / pinctrl-1 + pinctrl-names with 2 entries).
 */

&pinctrl {
    uart1_default: uart1_default {
        group1 {
            psels = <NRF_PSEL(UART_RX, 0, 8)>;   /* P0.08 — RX only, no TX needed */
        };
    };

    uart1_sleep: uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_RX, 0, 8)>;
            low-power-enable;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_default>;
    pinctrl-1 = <&uart1_sleep>;
    pinctrl-names = "default", "sleep";
};
