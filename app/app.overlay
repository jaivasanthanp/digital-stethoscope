/*
 * Digital Stethoscope - STM32U575 devicetree overlay
 *
 * Current revision:
 *   - No active ICS-43434 microphone path.
 *   - Synthetic PCG strings are rendered in firmware and classified locally.
 *   - USART3 remains enabled for the nRF52840 UART bridge.
 *
 * Future microphone option:
 *   STM32U575 uses SAI rather than a classic I2S peripheral. If a compatible
 *   SAI/I2S microphone is added later, re-enable &sai1_b and CONFIG_I2S/DMA.
 */

/* SAI1 Block B is intentionally disabled for the synthetic-data build. */
&sai1_b {
    status = "disabled";
};

/* USART3 - bridge to nRF52840 */
&usart3 {
    status = "okay";
    pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
    pinctrl-names = "default";
    current-speed = <115200>;
};
