/*
 * Digital Stethoscope — STM32U575 devicetree overlay
 *
 * NOTE: STM32U575 uses SAI (Serial Audio Interface) for audio, not I2S.
 * Zephyr exposes the STM32 SAI as an I2S-compatible device via the
 * i2s_stm32_sai.c driver (compatible = "st,stm32-sai").
 *
 * ICS-43434 MEMS microphone wiring — SAI1 Block B (receiver):
 *   ICS-43434 BCLK  -> PB3   (sai1_sck_b_pb3)
 *   ICS-43434 LRCLK -> PB6   (sai1_fs_b_pb6)
 *   ICS-43434 DOUT  -> PB5   (sai1_sd_b_pb5)
 *   ICS-43434 L/R   -> GND   (selects left channel)
 *   ICS-43434 VDD   -> 3.3V
 *
 * Verify PB3/PB5/PB6 are free on NUCLEO-U575ZI-Q CN7/CN10 headers.
 *
 * USART3 (PD8/PD9) — UART bridge to nRF52840 at 115200 baud.
 */

/* SAI1 Block B — ICS-43434 receiver (RX only) */
&sai1_b {
    status = "okay";
    pinctrl-0 = <&sai1_sck_b_pb3 &sai1_fs_b_pb6 &sai1_sd_b_pb5>;
    pinctrl-names = "default";
    dma-names = "rx";
};

/* USART3 — bridge to nRF52840 */
&usart3 {
    status = "okay";
    pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
    pinctrl-names = "default";
    current-speed = <115200>;
};
